* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}
body {
    background: #101827;
    color: white;
    font-family: Arial, sans-serif;
}
header {
    background: #17243a;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 15px;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 8px;
}

section {
    padding: 65px 30px;
    text-align: center;
}

h1 {
    color: #38bdf8;
    font-size: 38px;
    margin-bottom: 15px;
}

p {
    line-height: 1.8;
}

footer{
    text-align: center;
    padding: 20px;
    background: #17243a;
}
@media (max-width: 600px){
    header{
        flex-direction: column;
        align-items: center;
    }
    nav a {
        display: inline-block;
        margin: 8px 4px;
    }
    h1{
        fort-size: 28px;
    }
}